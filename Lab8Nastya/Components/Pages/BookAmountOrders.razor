@page "/book-amount-orders"

<PageTitle>BookAmountOrders</PageTitle>
<RadzenStack>
    <RadzenRow AlignItems="AlignItems.Center">
        <RadzenColumn Size="12" SizeMD="6">
            <RadzenText Text="BookAmountOrders" TextStyle="TextStyle.H3" TagName="TagName.H1" style="margin: 0" />
        </RadzenColumn>
        <RadzenColumn Size="12" SizeMD="6">
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.End" Gap="0.5rem">
                <RadzenSplitButton Icon="get_app" Text="Export" Click="@ExportClick" Variant="Variant.Flat" Shade="Shade.Lighter">
                    <RadzenSplitButtonItem Text="Excel" Value="xlsx" />
                    <RadzenSplitButtonItem Text="CSV" Value="csv" />
                </RadzenSplitButton>
                <RadzenButton Icon="add_circle_outline" Text="Add" Click="@AddButtonClick" Variant="Variant.Flat" />
            </RadzenStack>
        </RadzenColumn>
    </RadzenRow>
    <RadzenTextBox Placeholder="Search ..." style="display: block; width: 100%" @oninput="@Search" aria-label="Search by all string columns" />
    <RadzenRow>
      <RadzenColumn SizeMD=12>
        <RadzenDataGrid @ref="grid0" ColumnWidth="200px"   AllowFiltering="true" FilterMode="FilterMode.Advanced" AllowPaging="true" AllowSorting="true" ShowPagingSummary="true" PageSizeOptions=@(new int[]{5, 10, 20, 30})
            Data="@bookAmountOrders" TItem="Lab8Nastya.Models.BookStore.BookAmountOrder" RowDoubleClick="@EditRow">
            <Columns>
                <RadzenDataGridColumn TItem="Lab8Nastya.Models.BookStore.BookAmountOrder" Property="RecordId" Title="Record Id">
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="Lab8Nastya.Models.BookStore.BookAmountOrder" Property="Order.DeliveryAddress" Title="Order">
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="Lab8Nastya.Models.BookStore.BookAmountOrder" Property="Book.Title" Title="Book">
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="Lab8Nastya.Models.BookStore.BookAmountOrder" Property="Quantity" Title="Quantity">
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="Lab8Nastya.Models.BookStore.BookAmountOrder" Property="SoldByPrice" Title="Sold By Price">
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="Lab8Nastya.Models.BookStore.BookAmountOrder" Filterable="false" Sortable="false" Width="70px" TextAlign="TextAlign.Center">
                    <Template Context="bookAmountOrder">

                        <RadzenButton ButtonStyle="ButtonStyle.Danger" Icon="delete" Size="ButtonSize.Medium"
                            Shade="Shade.Lighter" Variant="Variant.Flat"
                            Click=@(args => GridDeleteButtonClick(args, bookAmountOrder)) @onclick:stopPropagation="true" />
                    </Template>
                </RadzenDataGridColumn>
            </Columns>

        </RadzenDataGrid>

    </RadzenColumn>
  </RadzenRow>
</RadzenStack>
