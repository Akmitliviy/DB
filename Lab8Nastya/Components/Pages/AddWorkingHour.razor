@page "/add-working-hour"

<PageTitle>Add WorkingHour</PageTitle>
    <RadzenColumn SizeMD=12>
        <RadzenAlert Shade="Shade.Lighter" Variant="Variant.Flat" Size="AlertSize.Small" AlertStyle="AlertStyle.Danger" Visible="@errorVisible">Cannot save WorkingHour</RadzenAlert>
        <RadzenTemplateForm TItem="Lab8Nastya.Models.BookStore.WorkingHour" Data="@workingHour" Visible="@(workingHour != null)" Submit="@FormSubmit">
            <RadzenRow style="margin-bottom: 1rem">
                <RadzenColumn SizeMD="3">
                    <RadzenLabel Text="Location" Component="Location" style="width: 100%" />
                </RadzenColumn>
                <RadzenColumn SizeMD="9">
                    <RadzenDropDownDataGrid Data="@locationsForLocationId" TextProperty="LocationType" ValueProperty="LocationId" AllowClear=true
                         Placeholder="Choose Location" style="display: block; width: 100%" @bind-Value="@workingHour.LocationId" Name="LocationId"
                           />
                </RadzenColumn>
            </RadzenRow>
            <RadzenRow style="margin-bottom: 1rem">
                <RadzenColumn SizeMD="3">
                    <RadzenLabel Text="Weekdays Start" Component="WeekdaysStart" style="width: 100%" />
                </RadzenColumn>
                <RadzenColumn SizeMD="9">
                    <RadzenRequiredValidator Component="WeekdaysStart" Text="WeekdaysStart is required" />
                </RadzenColumn>
            </RadzenRow>
            <RadzenRow style="margin-bottom: 1rem">
                <RadzenColumn SizeMD="3">
                    <RadzenLabel Text="Weekdays End" Component="WeekdaysEnd" style="width: 100%" />
                </RadzenColumn>
                <RadzenColumn SizeMD="9">
                    <RadzenRequiredValidator Component="WeekdaysEnd" Text="WeekdaysEnd is required" />
                </RadzenColumn>
            </RadzenRow>
            <RadzenRow style="margin-bottom: 1rem">
                <RadzenColumn SizeMD="3">
                    <RadzenLabel Text="Saturday Start" Component="SaturdayStart" style="width: 100%" />
                </RadzenColumn>
                <RadzenColumn SizeMD="9">
                </RadzenColumn>
            </RadzenRow>
            <RadzenRow style="margin-bottom: 1rem">
                <RadzenColumn SizeMD="3">
                    <RadzenLabel Text="Saturday End" Component="SaturdayEnd" style="width: 100%" />
                </RadzenColumn>
                <RadzenColumn SizeMD="9">
                </RadzenColumn>
            </RadzenRow>
            <RadzenRow style="margin-bottom: 1rem">
                <RadzenColumn SizeMD="3">
                    <RadzenLabel Text="Sunday Start" Component="SundayStart" style="width: 100%" />
                </RadzenColumn>
                <RadzenColumn SizeMD="9">
                </RadzenColumn>
            </RadzenRow>
            <RadzenRow style="margin-bottom: 1rem">
                <RadzenColumn SizeMD="3">
                    <RadzenLabel Text="Sunday End" Component="SundayEnd" style="width: 100%" />
                </RadzenColumn>
                <RadzenColumn SizeMD="9">
                </RadzenColumn>
            </RadzenRow>
          <RadzenStack  Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.End" Gap="0.5rem">
                    <RadzenButton ButtonStyle="ButtonStyle.Primary" ButtonType="ButtonType.Submit" Icon="save" Text="Save" Variant="Variant.Flat" />
                    <RadzenButton ButtonStyle="ButtonStyle.Light" Text="Cancel" Variant="Variant.Flat" Click="@CancelButtonClick"  />
          </RadzenStack>
        </RadzenTemplateForm>
    </RadzenColumn>

