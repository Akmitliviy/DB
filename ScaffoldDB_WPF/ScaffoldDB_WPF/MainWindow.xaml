<Window x:Class="ScaffoldDB_WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ScaffoldDB_WPF"
        mc:Ignorable="d"
        Title="MainWindow" Height="600" Width="800">
    <Grid>
        <TabControl Name="MainTabControl">
            <!-- Example Tab for Clients -->
            <TabItem Header="Clients">
                <Grid>
                    <DataGrid Name="ClientsDataGrid" AutoGenerateColumns="True" Margin="10"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="10">
                        <!-- Input Fields -->
                        <TextBox Name="ClientEmailTextBox" Width="150" Text="Email" />
                        <TextBox Name="ClientFirstNameTextBox" Width="150" Text="First Name" />
                        <Button Content="Add"/>
                        <Button Content="Delete"/>
                        <Button Content="Refresh"/>
                    </StackPanel>
                </Grid>
            </TabItem>
            <!-- Repeat for other tables -->
        </TabControl>
    </Grid>
</Window>
